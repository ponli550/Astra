{
  "$schema": "https://opencode.ai/config.json",
  // Registers this project's contract functions as agent tools. OpenCode
  // spawns the server over stdio, so nothing listens on a port and no
  // model key is needed: `opencode models` lists several free models.
  //
  // The server holds the agent's key only. It never holds the tenant's
  // key or the data owner's key, and the identity whose grant authorises
  // each call comes from .env, exactly as a real agent would receive it.
  // Pinned so the TUI opens straight to a prompt instead of a model picker,
  // which matters when the session is being recorded. One of the models
  // OpenCode offers at no cost; verified to drive the vault tools correctly.
  "model": "opencode/big-pickle",
  "mcp": {
    "t3n-consent-vault": {
      "type": "local",
      "command": ["npx", "tsx", "src/mcp/server.ts"],
      "enabled": true
    }
  }
}
