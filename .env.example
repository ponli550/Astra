# T3N network. "testnet" and "sandbox" are the same test network.
T3N_ENV=testnet

# --- TENANT (you, the developer) -------------------------------------
# Owns the contract and the maps, and pays the credits to register them.
# Claim from the T3N test-token page. The DID must be the one this key
# authenticates as; the scripts cross-check it and refuse a mismatch.
T3N_API_KEY=0x...
DID=did:t3n:...

# --- AGENT (the thing acting for a user) -----------------------------
# Its OWN key, claimed separately. This is the one identity that cannot
# be shared with another role: an identity granting itself is a
# self-grant, which demonstrates nothing, and an agent's credit balance
# is separate from its tenant's and starts at zero.
AGENT_KEY=0x...

# --- DATA OWNER (optional third identity) ----------------------------
# The claim page issues one key per work email, so three identities
# means three addresses. Two is enough.
#
# Leave USER_KEY blank and the tenant acts as the data owner, which is
# how Terminal 3's own reference demo is written: it runs its grant as
# the tenant and sets the grant subject to the tenant's identity.
#
# The cost is narration, not substance. With two keys the demo reads as
# a developer delegating to their own agent rather than a third party
# delegating to someone else's. The enforcement and the audit trail are
# identical either way.
USER_KEY=

# Whose grant a delegated call is checked against. `npm run grant`
# prints this line for you. Leave it blank and the scripts resolve it by
# authenticating as the data owner, which is a demo-only shortcut: a
# real agent is given this DID out of band and never holds a key for it.
#
# Omitting it on a real call is the single most common cause of a
# confusing denial: the node checks the agent's own grants, which are
# empty, instead of the grants the data owner signed.
USER_DID=

# --- Deployment ------------------------------------------------------
# Local contract name inside your tenant namespace, stored as
# z:<tid>:<tail>. Keep it short: the full name is reused in delegation
# grants, where length limits are stricter than at registration.
CONTRACT_TAIL=consent-vault

# The contract id an earlier deploy printed. Registration returns it but
# nothing looks it up afterwards, so record it here: without it, a later
# deploy at an already-registered version cannot re-point map rules at
# the right contract.
CONTRACT_ID=

# Must increase on every re-register. A version that is not strictly
# higher than the deployed one is refused.
CONTRACT_VERSION=0.2.0

# Built by `npm run contract:build`.
WASM_PATH=contract/target/wasm32-wasip2/release/z_tenant_consent.wasm

# How long the user's grant to the agent stays valid, in seconds.
GRANT_TTL_SECS=900

# How often the console re-reads state, in milliseconds. Each poll makes
# three metered calls and the node enforces a per-minute fuel quota per
# tenant, so going much below this risks "quota exceeded".
MONITOR_POLL_MS=10000
