# T3N network. "testnet" and "sandbox" are the same test network.
T3N_ENV=testnet

# --- TENANT (you, the developer) -------------------------------------
# Owns the contract and the maps, and pays the credits to register them.
# Claim from the T3N test-token page. The DID must be the one this key
# authenticates as; the scripts cross-check it and refuse a mismatch.
T3N_API_KEY=0x...
DID=did:t3n:...

# --- AGENT (the thing acting for a user) -----------------------------
# Its OWN key, claimed separately. An agent DID's credit balance is
# separate from its tenant's and starts at zero, so reusing the tenant
# key here fails metered calls with InsufficientCreditError.
AGENT_KEY=0x...

# --- USER (the data owner) -------------------------------------------
# Stands in for a real user. Only this identity can grant the agent
# access to the contract; neither the tenant nor the agent can.
USER_KEY=0x...

# Whose grant a delegated call is checked against. `npm run grant`
# prints this line for you. Leave it blank and the scripts fall back to
# authenticating with USER_KEY to resolve it, which is a demo-only
# shortcut: a real agent is given this DID out of band and never holds
# the data owner's key.
#
# Omitting it on a real call is the single most common cause of a
# confusing denial: the node checks the agent's own grants, which are
# empty, instead of the grants the data owner signed.
USER_DID=

# --- Deployment ------------------------------------------------------
# Local contract name inside your tenant namespace, stored as
# z:<tid>:<tail>. Keep it short: the full name is reused in delegation
# grants, where length limits are stricter than at registration.
CONTRACT_TAIL=consent-vault

# Must increase on every re-register. A version that is not strictly
# higher than the deployed one is refused.
CONTRACT_VERSION=0.2.0

# Built by `npm run contract:build`.
WASM_PATH=contract/target/wasm32-wasip2/release/z_tenant_consent.wasm

# How long the user's grant to the agent stays valid, in seconds.
GRANT_TTL_SECS=900
