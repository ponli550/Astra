/// z-tenant-consent — auditable-consent data vault.
///
/// Track: "Private data access with auditable consent".
///
/// Deliberately imports the BASE tenant capability set only:
///   tenant-context, logging, kv-store
///
/// No `http` / `http-with-placeholders` import, so the contract links
/// against the `tenant-base` linker world and the demo needs no
/// third-party API key and no egress grant. Adding an outbound call
/// later means adding the import here AND adding the host to the
/// delegating user's `allowed_hosts`.
package z:tenant-consent@0.5.1;

world tenant-consent {
    import host:tenant/tenant-context@1.0.0;
    import host:interfaces/logging@2.1.0;
    import host:interfaces/kv-store@2.1.0;

    export contracts;
}

interface contracts {
    /// Uniform 3-field envelope every node-callable contract takes.
    ///   input        — JSON arguments for this function, as bytes
    ///   user-profile — always None for tenant contracts
    ///   context      — node-minted DynamicContext (trusted), as bytes
    record generic-input {
        input:        option<list<u8>>,
        user-profile: option<list<u8>>,
        context:      option<list<u8>>,
    }

    /// Write a record into the tenant vault.
    /// Input  (JSON): { record_id, payload }
    /// Output (JSON): { record_id, written_at_secs, seq_no }
    vault-put: func(req: generic-input) -> result<list<u8>, string>;

    /// Read a vault record. Refuses unless the node bound a calling user
    /// to this execution, and appends an audit entry before returning.
    /// Input  (JSON): { record_id, purpose }
    /// Output (JSON): { record_id, payload, audit_key }
    vault-read: func(req: generic-input) -> result<list<u8>, string>;

    /// Enumerate audit entries in sequence order.
    /// Input  (JSON): { limit }
    /// Output (JSON): { entries: [AuditEntry], count, malformed-entries }
    audit-list: func(req: generic-input) -> result<list<u8>, string>;

    /// Replace the consent policy. Permitted only from the tenant's own
    /// identity, checked inside the enclave against node-minted context,
    /// and recorded in the same audit trail as the accesses so that
    /// widening permission is as visible as using it.
    /// Input  (JSON): { allowed_callers, allowed_functions, valid_until_secs }
    /// Output (JSON): { version, allowed_callers, allowed_functions,
    ///                  valid_until_secs, audit_key }
    policy-set: func(req: generic-input) -> result<list<u8>, string>;

    /// Read the consent policy in force. Readable by the tenant, so the
    /// owner can inspect what they have granted and what has been handed on.
    /// Output (JSON): { version, allowed_callers, allowed_functions,
    ///                  valid_until_secs, delegations, now_secs, expired }
    policy-get: func(req: generic-input) -> result<list<u8>, string>;

    /// Hand part of the caller's own permission to another identity.
    /// Permitted only to a caller that currently holds something, and only
    /// for a subset of it: the same functions or fewer, the same expiry or
    /// sooner, never past the chain's depth cap. Widening is refused inside
    /// the enclave and recorded. Every use downstream is intersected with
    /// what the delegator still holds, so withdrawing consent at the root
    /// empties the chain without deleting anything.
    /// Input  (JSON): { to, functions, valid_until_secs }
    /// Output (JSON): { status, reason?, version, from, to, functions,
    ///                  valid_until_secs, depth, audit_key }
    policy-delegate: func(req: generic-input) -> result<list<u8>, string>;

    /// Diagnostic: what the node tells this contract about who is calling.
    /// Returns the tenant DID, the calling-user DID from tenant-context, and
    /// the node-minted context bytes verbatim, so the exact shape the host
    /// sends on self and delegated calls can be seen rather than assumed.
    /// Output (JSON): { tenant_did, calling_user_did, context_utf8, context_len }
    whoami: func(req: generic-input) -> result<list<u8>, string>;
}
